{
  "name": "shinobi-no-vale",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "preview": "vite preview",
    "map:inspect": "node tools/map/inspect-otbm.mjs",
    "map:export": "node tools/map/export-shinobi-chunks.mjs",
    "desktop:build": "npm run build && electron-builder --win portable",
    "desktop:dir": "npm run build && electron-builder --win dir"
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "typescript": "5.9.2",
    "vite": "7.1.7",
    "vitest": "3.2.4",
    "@v0rt4c/otbm": "0.2.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.shinobinodevale.game",
    "productName": "Shinobi no Vale",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Shinobi-no-Vale-${version}-portable.${ext}"
    },
    "portable": {
      "artifactName": "Shinobi-no-Vale-${version}-portable.${ext}"
    },
    "publish": null
  }
}
